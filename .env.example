# Base URL of the Doener backend API, e.g. http://localhost:8000 or
# https://doener-backend.up.railway.app -- no trailing slash.
# This is the ONLY way the frontend knows where the backend lives: it is
# read at build time by Vite (import.meta.env.VITE_API_BASE_URL) and never
# hardcoded anywhere in the source.
VITE_API_BASE_URL=http://localhost:8000
